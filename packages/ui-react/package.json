{
	"name": "@zayne-labs/ui-react",
	"type": "module",
	"version": "0.13.0",
	"description": "A composable UI/UI-utilities components library. ",
	"author": "Ryan Zayne",
	"license": "MIT",
	"homepage": "https://zayne-labs-ui.vercel.app",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zayne-labs/ui.git"
	},
	"bugs": {
		"url": "https://github.com/zayne-labs/ui/issues"
	},
	"keywords": [],
	"sideEffects": false,
	"exports": {
		".": null,
		"./ui/*": "./dist/components/ui/*/index.js",
		"./common/*": "./dist/components/common/*/index.js",
		"./css/*": "./css/*",
		"./style.css": "./dist/style.css"
	},
	"files": [
		"css",
		"dist"
	],
	"engines": {
		"node": ">=18.x"
	},
	"scripts": {
		"build": "concurrently 'pnpm:build:tailwind' 'tsdown'",
		"build:dev": "cross-env NODE_ENV=development tsdown",
		"build:tailwind": "tailwindcss -i=css/style.css -o=./dist/style.css",
		"build:test": "concurrently --prefix-colors \"yellow.bold,#7da4f8.bold,magenta\" --names PUBLINT,TSUP 'pnpm:lint:publint' 'pnpm:build:dev'",
		"dev": "pnpm build:dev --watch",
		"lint:attw": "attw --pack . --profile esm-only --format table-flipped --ignore-rules=cjs-resolves-to-esm --ignore-rules=named-exports",
		"lint:eslint": "eslint . --max-warnings=0",
		"lint:eslint:interactive": "pnpx eslint-interactive@latest . --max-warnings=0 --fix",
		"lint:format": "prettier --write .",
		"lint:publint": "publint --strict .",
		"lint:size": "size-limit",
		"lint:type-check": "tsc --pretty -p tsconfig.json",
		"release": "pnpm publish --no-git-checks",
		"release:test": "pnpx pkg-pr-new publish"
	},
	"peerDependencies": {
		"react": "catalog:react:peer",
		"react-dom": "catalog:react:peer",
		"react-hook-form": "catalog:react:peer",
		"tailwind-merge": "catalog:react:peer",
		"tailwindcss": "catalog:react:peer"
	},
	"peerDependenciesMeta": {
		"react-hook-form": {
			"optional": true
		},
		"tailwindcss": {
			"optional": true
		}
	},
	"dependencies": {
		"@zayne-labs/toolkit-core": "0.13.2",
		"@zayne-labs/toolkit-react": "0.13.2",
		"@zayne-labs/toolkit-type-helpers": "0.13.2"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@size-limit/preset-small-lib": "14.3.0",
		"@tailwindcss/cli": "4.3.5",
		"@total-typescript/ts-reset": "0.6.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@zayne-labs/prettier-config": "0.14.0",
		"@zayne-labs/tsconfig": "0.14.0",
		"concurrently": "10.0.7",
		"cross-env": "10.1.0",
		"prettier": "3.9.10",
		"prettier-plugin-classnames": "0.10.5",
		"prettier-plugin-merge": "0.10.2",
		"prettier-plugin-tailwindcss": "0.8.1",
		"publint": "0.3.25",
		"react": "catalog:react:peer",
		"react-dom": "catalog:react:peer",
		"react-hook-form": "catalog:react:peer",
		"size-limit": "14.3.0",
		"tailwind-merge": "catalog:react:peer",
		"tailwindcss": "catalog:react:peer",
		"tsdown": "0.23.7",
		"typescript": "6.0.3"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/",
		"provenance": true
	},
	"size-limit": [
		{
			"name": "ui/card",
			"path": "src/components/ui/card/index.ts",
			"limit": "1.5 kB"
		},
		{
			"name": "ui/carousel",
			"path": "src/components/ui/carousel/index.ts",
			"limit": "5 kB"
		},
		{
			"name": "ui/drag-scroll",
			"path": "src/components/ui/drag-scroll/index.ts",
			"limit": "5.5 kB"
		},
		{
			"name": "ui/drop-zone",
			"path": "src/components/ui/drop-zone/index.ts",
			"limit": "12 kB"
		},
		{
			"name": "ui/form",
			"path": "src/components/ui/form/index.ts",
			"limit": "7.5 kB"
		},
		{
			"name": "common/await",
			"path": "src/components/common/await/index.ts",
			"limit": "3 kB"
		},
		{
			"name": "common/client-gate",
			"path": "src/components/common/client-gate/index.ts",
			"limit": "0.5 kB"
		},
		{
			"name": "common/error-boundary",
			"path": "src/components/common/error-boundary/index.ts",
			"limit": "1 kB"
		},
		{
			"name": "common/for",
			"path": "src/components/common/for/index.ts",
			"limit": "0.5 kB"
		},
		{
			"name": "common/presence",
			"path": "src/components/common/presence/index.ts",
			"limit": "3.5 kB"
		},
		{
			"name": "common/scroll-lock",
			"path": "src/components/common/scroll-lock/index.ts",
			"limit": "4.5 kB"
		},
		{
			"name": "common/show",
			"path": "src/components/common/show/index.ts",
			"limit": "2 kB"
		},
		{
			"name": "common/slot",
			"path": "src/components/common/slot/index.ts",
			"limit": "1.5 kB"
		},
		{
			"name": "common/suspense-with-boundary",
			"path": "src/components/common/suspense-with-boundary/index.ts",
			"limit": "1 kB"
		},
		{
			"name": "common/switch",
			"path": "src/components/common/switch/index.ts",
			"limit": "1.5 kB"
		},
		{
			"name": "common/teleport",
			"path": "src/components/common/teleport/index.ts",
			"limit": "0.5 kB"
		}
	]
}
